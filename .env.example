# 复制此文件为 .env 并填入真实 Key
# cp .env.example .env

# DeepSeek API Key（https://platform.deepseek.com）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 高德地图 Web 服务 Key（后端调用路线/搜索 API）
# 在高德控制台创建「Web 服务」类型应用获取
# https://console.amap.com
AMAP_KEY=your_amap_web_service_key_here

# 高德地图 JS API Key（前端地图渲染）
# 在高德控制台创建「Web 端（JS API）」类型应用获取
# 需在控制台将 localhost 和 127.0.0.1 加入域名白名单
AMAP_JS_KEY=your_amap_js_api_key_here

# Agent 运行时。试验期间保持 legacy；只有明确放量时才改为 langgraph。
MIDDOT_AGENT_RUNTIME=legacy
# LangGraph 等待状态的独立 SQLite checkpoint；正式多实例部署应改用 PostgresSaver。
MIDDOT_LANGGRAPH_DB_PATH=middot-agent-checkpoints.db

# LangSmith 只用于研发诊断，默认完全关闭。关闭时不初始化 SDK，也不发送数据。
MIDDOT_LANGSMITH_TRACING=false
MIDDOT_LANGSMITH_PROJECT=middot-staging
MIDDOT_LANGSMITH_SAMPLE_RATE=0
# 默认不上传用户原文、地点名或地址；仅合成/脱敏环境可显式开启。
MIDDOT_LANGSMITH_INCLUDE_CONTENT=false
# 启用 LangSmith 时另行配置 LANGSMITH_API_KEY；严禁提交真实 key。
